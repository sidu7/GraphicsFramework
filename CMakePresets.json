{
  "version": 3,
  "configurePresets": [
    {
      "name": "Ninja-Multi",
      "displayName": "Ninja Multi-Config",
      "description": "Multi-configuration Ninja build",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja-multi",
      "cacheVariables": {}
    }
  ],
  "buildPresets": [
    {
      "name": "OpenGL-Debug",
      "configurePreset": "Ninja-Multi",
      "configuration": "Debug_OpenGL"
    },
    {
      "name": "OpenGL-Release",
      "configurePreset": "Ninja-Multi",
      "configuration": "Release_OpenGL"
    },
    {
      "name": "Vulkan-Debug",
      "configurePreset": "Ninja-Multi",
      "configuration": "Debug_Vulkan"
    },
    {
      "name": "Vulkan-Release",
      "configurePreset": "Ninja-Multi",
      "configuration": "Release_Vulkan"
    }
  ]
}